{
  "name": "@app/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "tsdown",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=../../.env prisma/seed.ts",
    "admin:create": "tsx --env-file=../../.env src/cli/admin-create.ts",
    "admin:reset-password": "tsx --env-file=../../.env src/cli/admin-reset-password.ts"
  },
  "dependencies": {
    "@app/shared": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "fastify-type-provider-zod": "^7.0.0",
    "file-type": "^22.2.0",
    "grammy": "^1.46.0",
    "prisma": "7.10.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
